---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import CTABand from '../components/CTABand.astro';
import Footer from '../components/Footer.astro';

const BOOKSY = 'https://booksy.com/es-es/92461_luis-tijera-barberia_barberia_52925_alcobendas?utm_source=web&utm_medium=cta&utm_campaign=luistijera_servicios';

const barberia = [
  { name: 'Corte clásico', price: '18,90 €', time: '25 min' },
  { name: 'Corte taper fade', price: '18,90 €', time: '30 min' },
  { name: 'Corte + lavado y peinado', price: '18,90 €', time: '30 min' },
  { name: 'Corte mullet', price: '18,90 €', time: '30 min' },
  { name: 'Corte niño', price: '18,90 €', time: '30 min' },
  { name: 'Corte jubilado', price: '15,90 €', time: '25 min' },
  { name: 'Afeitado de barba tradicional', price: '20,90 €', time: '30 min' },
  { name: 'Corte + afeitado tradicional', price: '35,90 €', time: '55 min' },
  { name: 'Corte + barba shaver', price: '32,90 €', time: '55 min' },
];
// ⚠️ PENDIENTE CLIENTE: confirmar precios

const peluqueria = [
  { name: 'Coloración', price: '⚠️ Consultar', time: '' },
  { name: 'Extensiones', price: '⚠️ Consultar', time: '' },
];
// ⚠️ PENDIENTE CLIENTE: precios peluquería
---

<Layout
  title="Servicios y Precios — Luis Tijera Barbería Alcobendas"
  description="Todos los servicios y precios de Luis Tijera: cortes, taper fade, degradados, afeitado tradicional y peluquería. Desde 15,90 €. Alcobendas, Madrid."
  canonical="/servicios"
>
  <Nav />

  <main class="pt-16">
    <section class="py-16 px-4 sm:py-20">
      <div class="mx-auto max-w-2xl">
        <div class="text-center reveal">
          <p class="text-xs font-semibold uppercase tracking-widest text-terracota">Precios actualizados</p>
          <h1 class="mt-2 font-serif text-3xl font-bold sm:text-4xl">Servicios y precios</h1>
          <p class="mt-2 text-sm text-texto/50">Sin sorpresas. Lo que ves es lo que pagas.</p>
        </div>

        <!-- BARBERÍA -->
        <div class="mt-12">
          <h2 class="reveal font-serif text-xl font-bold flex items-center gap-2">
            <span class="inline-block w-8 h-px bg-terracota"></span>
            Barbería
          </h2>
          <p class="mt-1 text-xs text-texto/40 reveal">Disponible en ambos locales</p>

          <div class="mt-6">
            {barberia.map((s, i) => (
              <div class="reveal flex items-center justify-between border-b border-borde py-4 group" style={`transition-delay: ${i * 40}ms`}>
                <div>
                  <span class="text-sm font-medium text-texto group-hover:text-terracota transition-colors">{s.name}</span>
                  <span class="ml-2 text-xs text-texto/40">{s.time}</span>
                </div>
                <span class="text-base font-semibold text-terracota">{s.price}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- PELUQUERÍA -->
        <div class="mt-12">
          <h2 class="reveal font-serif text-xl font-bold flex items-center gap-2">
            <span class="inline-block w-8 h-px bg-bosque"></span>
            Peluquería
          </h2>
          <p class="mt-1 text-xs text-texto/40 reveal">Solo en el local de Centro (C. Libertad, 4)</p>

          <div class="mt-6">
            {peluqueria.map((s, i) => (
              <div class="reveal flex items-center justify-between border-b border-borde py-4 group" style={`transition-delay: ${i * 40}ms`}>
                <span class="text-sm font-medium text-texto group-hover:text-bosque transition-colors">{s.name}</span>
                <span class="text-sm font-semibold text-bosque">{s.price}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- CTA -->
        <div class="mt-12 text-center reveal">
          <a
            href={BOOKSY}
            target="_blank"
            rel="noopener nofollow"
            class="inline-block rounded-pill bg-terracota px-8 py-3.5 text-sm font-medium text-white hover:bg-terracota/90 transition-colors"
            onclick="gtag('event', 'reserva_booksy', { 'metodo': 'servicios' })"
          >
            Reservar cita →
          </a>
          <p class="mt-3 text-xs text-texto/40">Reserva online en Booksy o llama directamente</p>
        </div>
      </div>
    </section>

    <CTABand />
  </main>

  <Footer />
</Layout>

<style is:global>
  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>
