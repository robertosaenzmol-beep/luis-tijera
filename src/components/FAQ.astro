---
const faqs = [
  {
    q: '¿Necesito reservar o puedo ir sin cita?',
    a: 'Recomendamos reservar por Booksy para no esperar, pero si hay hueco te atendemos sin cita.',
  },
  {
    q: '¿Hacéis cortes de niño?',
    a: 'Sí. Corte de niño a 18,90 €. Ambos locales son aptos para niños.',
  },
  {
    q: '¿Cuál es la diferencia entre los dos locales?',
    a: 'El de Centro (C. Libertad) ofrece servicios de peluquería además de barbería: coloración, extensiones, etc. El de La Ermita es barbería pura: cortes, fades y afeitado.',
  },
  {
    q: '¿Aceptáis tarjeta?',
    a: 'Sí, aceptamos tarjeta y efectivo en ambos locales.', // ⚠️ PENDIENTE CLIENTE: confirmar
  },
  {
    q: '¿Tenéis aparcamiento?',
    a: 'Hay aparcamiento en la zona de ambos locales. El de La Ermita tiene más facilidad para aparcar.',
  },
  {
    q: '¿Cuál es el horario?',
    a: 'Lunes a sábado de 10:00 a 20:00. Domingos cerrado.',
  },
];
---

<section class="py-16 px-4 sm:py-20" id="faq">
  <div class="mx-auto max-w-2xl">
    <div class="text-center reveal">
      <p class="text-xs font-semibold uppercase tracking-widest text-terracota">Preguntas frecuentes</p>
      <h2 class="mt-2 font-serif text-3xl font-bold sm:text-4xl">¿Alguna duda?</h2>
    </div>

    <div class="mt-10 space-y-3">
      {faqs.map((faq, i) => (
        <details class="reveal group rounded-card border border-borde bg-superficie" style={`transition-delay: ${i * 60}ms`}>
          <summary class="flex cursor-pointer items-center justify-between px-5 py-4 text-sm font-medium text-texto hover:text-terracota transition-colors list-none [&::-webkit-details-marker]:hidden">
            {faq.q}
            <svg class="w-4 h-4 shrink-0 text-texto/30 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-5 pb-4 text-sm text-texto/60 leading-relaxed">
            {faq.a}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
