---
const BOOKSY = 'https://booksy.com/es-es/92461_luis-tijera-barberia_barberia_52925_alcobendas?utm_source=web&utm_medium=cta&utm_campaign=luistijera';
---

<footer class="border-t border-borde bg-superficie">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">

      <!-- Marca -->
      <div>
        <span class="font-serif text-lg font-bold">Luis Tijera</span>
        <p class="mt-2 text-sm text-texto/60 leading-relaxed">
          Barbería y peluquería en Alcobendas.<br />
          Dos locales, un equipo.
        </p>
        <div class="mt-4 flex gap-3">
          <a href="https://www.instagram.com/luis_tijera_/" target="_blank" rel="noopener nofollow" class="text-texto/40 hover:text-terracota transition-colors" aria-label="Instagram">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
          <a href="https://www.tiktok.com/@barberialuistijera" target="_blank" rel="noopener nofollow" class="text-texto/40 hover:text-terracota transition-colors" aria-label="TikTok">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 00-.79-.05A6.34 6.34 0 003.15 15.2a6.34 6.34 0 0010.86 4.48v-7.1a8.16 8.16 0 005.58 2.2V11.3a4.85 4.85 0 01-2.43-.67 4.88 4.88 0 01-1.57-1.57V6.69h2z"/></svg>
          </a>
          <a href="https://www.facebook.com/LuisTijeraPerluqueria" target="_blank" rel="noopener nofollow" class="text-texto/40 hover:text-terracota transition-colors" aria-label="Facebook">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
        </div>
      </div>

      <!-- Local 1 -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-texto/40">Centro</h3>
        <address class="mt-3 space-y-1 text-sm not-italic text-texto/70 leading-relaxed">
          <p>C. de la Libertad, 4</p>
          <p>28100 Alcobendas, Madrid</p>
          <a href="tel:+34626290492" class="block hover:text-terracota transition-colors" onclick="gtag('event', 'clic_telefono', { 'local': 'centro' })">626 29 04 92</a>
          <p>L-S 10:00–20:00</p>
        </address>
      </div>

      <!-- Local 2 -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-texto/40">La Ermita</h3>
        <address class="mt-3 space-y-1 text-sm not-italic text-texto/70 leading-relaxed">
          <p>Av. de la Ermita, 1</p>
          <p>28108 Alcobendas, Madrid</p>
          <a href="tel:+34911477236" class="block hover:text-terracota transition-colors" onclick="gtag('event', 'clic_telefono', { 'local': 'ermita' })">911 477 236</a>
          <p>L-S 10:00–20:00</p>
        </address>
      </div>

      <!-- Links -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-texto/40">Enlaces</h3>
        <div class="mt-3 flex flex-col gap-2 text-sm text-texto/70">
          <a href="/servicios" class="hover:text-texto transition-colors">Servicios y precios</a>
          <a href="/galeria" class="hover:text-texto transition-colors">Galería</a>
          <a href="/blog" class="hover:text-texto transition-colors">Blog</a>
          <a href={BOOKSY} target="_blank" rel="noopener nofollow" class="hover:text-terracota transition-colors" onclick="gtag('event', 'reserva_booksy', { 'metodo': 'footer' })">Reservar en Booksy</a>
        </div>
      </div>
    </div>

    <!-- Bottom -->
    <div class="mt-10 flex flex-col items-center gap-3 border-t border-borde pt-6 text-xs text-texto/40 sm:flex-row sm:justify-between">
      <span>© 2026 Luis Tijera Barbería · Alcobendas, Madrid</span>
      <div class="flex gap-4">
        <a href="/aviso-legal" class="hover:text-texto/60 transition-colors">Aviso legal</a>
        <a href="/politica-de-privacidad" class="hover:text-texto/60 transition-colors">Privacidad</a>
        <a href="/politica-de-cookies" class="hover:text-texto/60 transition-colors">Cookies</a>
      </div>
    </div>
  </div>
</footer>
